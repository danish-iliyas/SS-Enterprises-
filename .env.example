# MongoDB connection. Local for development; use a MongoDB Atlas URI on Vercel.
MONGODB_URI=mongodb://127.0.0.1:27017/ss_enterprises

# Long random string used to sign admin login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# First admin account, created by `npm run seed` if it does not exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123

# Public site URL (used for SEO: sitemap, canonical links, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
